# Vice Go — variables PUBLIQUES uniquement (préfixe EXPO_PUBLIC_ = embarqué dans l'app).
# Ne JAMAIS mettre ici : clé secrète / service_role Supabase, clés Stripe secrètes,
# clés Apple / Google privées. Ces secrets vivent uniquement côté serveur.
#
# Copier ce fichier en .env.local (ignoré par git) pour le développement local.
# Pour les builds EAS, définir ces variables dans les environnements EAS
# (development / preview / production) — voir docs/vice-go/environnements.md.

# Source des données : "mock" (catalogue de démonstration embarqué, aucun réseau)
# ou "supabase" (projet Supabase défini ci-dessous). En phase 1 : mock.
EXPO_PUBLIC_DATA_SOURCE=mock

# Projet Supabase STAGING en développement — jamais la production.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
